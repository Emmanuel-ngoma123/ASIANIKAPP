# Fichier d'exemple pour les variables d'environnement.
# À copier sous le nom .env.local pour le développement local.

# SUPABASE CONFIGURATION
# Ces clés se trouvent dans les paramètres de votre projet Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique_supabase

# URL du site pour les envois d'emails et la génération de liens
NEXT_PUBLIC_SITE_URL=http://localhost:3000
